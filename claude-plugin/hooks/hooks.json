{
  "description": "Alabasta agent enforcement: a resolution gate on stop.",
  "hooks": {
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/stop.py\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
