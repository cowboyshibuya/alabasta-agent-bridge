{
  "description": "Alabasta agent enforcement for Codex — same hooks as the Claude Code plugin.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/PATH/TO/alabasta-agent-bridge/claude-plugin/hooks/rules_drift.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/PATH/TO/alabasta-agent-bridge/claude-plugin/hooks/stop.py\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
